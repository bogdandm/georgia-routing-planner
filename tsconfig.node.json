{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "eslint.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.coverage.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "tools/**/*.ts",
    "src/application/ports/TrailRouter.ts",
    "src/domain/tracks/gpx.ts",
    "src/domain/tracks/trackCalculations.ts",
    "src/infrastructure/routing/RoutingWorkerProtocol.ts",
    "src/infrastructure/routing/RoutingWorkerServer.ts",
    "src/infrastructure/routing/routingTiles.ts",
    "src/infrastructure/routing/trailGraph.ts",
    "src/infrastructure/runtime/WorkerRpc.ts",
    "src/bootstrap/configuration/MapProviderConfiguration.ts",
    "src/infrastructure/elevation/TerrariumDemFilter.ts",
    "src/domain/elevation/robustElevationStatistics.ts",
    "tests/helpers/referenceTerrariumDemFilter.ts",
    "tests/helpers/terrariumDemFilterFixtures.ts",
    "src/diagnostics/export/diagnosticBundleSchema.ts",
    "e2e/**/*.ts"
  ]
}
